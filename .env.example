# URL pública del sitio (canónicas, sitemap, Open Graph, JSON-LD).
# En local puedes dejar http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://www.valadaresglobaltech.com

# API key de Quo (OpenPhone) — crea un contacto por cada lead de los
# formularios. Se genera en my.quo.com → Settings → API. Solo servidor
# (sin NEXT_PUBLIC_). Si está vacía, la web funciona igual.
QUO_API_KEY=

# Chatbot de ventas (D-008) — llave de la API de Anthropic. Solo servidor.
# Sin llave, el widget degrada a ofrecer el formulario de contacto.
ANTHROPIC_API_KEY=
# Modelo del chatbot (default: claude-haiku-4-5, el económico).
CHAT_MODEL=

# TODO (Fase 2 / integraciones reales):
